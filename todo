import tkinter
import threading
import time





def cambiarestadisticas(path):
    img = tkinter.PhotoImage(file= f"{path}.png")
    lable= tkinter.Label()


#Aqui se escogen los wispers
def inicio_juego():
    ventana_selecciion = tkinter.Toplevel()
    ventana_selecciion.geometry("1024x768")

    imagen_fondo2 = tkinter.PhotoImage(file="./i/f2.png")
    lbl_imagen_fondo2 = tkinter.Label(ventana_selecciion, image= imagen_fondo2)
    lbl_imagen_fondo2.pack()

    ###Botón de prueba
    boton_select = tkinter.PhotoImage(file="./i/bs.png")
    boton_select = tkinter.Button(ventana_selecciion,   command= lambda: (cambiarestadisticas("bs")).place(x= 432, y= 352.5))
    
    ventana_selecciion.mainloop()


#ventana principal siempre al final
ventana_principal = tkinter.Tk()
ventana_principal.geometry("1024x768")

imagen_fondo1 = tkinter.PhotoImage(file="./i/f1.png")
lbl_imagen_fondo1 = tkinter.Label(ventana_principal, image= imagen_fondo1)
lbl_imagen_fondo1.pack()
boton_star = tkinter.PhotoImage(file="./i/bs.png")
boton_play = tkinter.Button(ventana_principal, image= boton_star, command= inicio_juego).place(x= 432, y= 352.5)

ventana_principal.mainloop()


